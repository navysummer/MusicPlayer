{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "琴韵音乐播放器",
  "version": "0.0.1",
  "identifier": "com.navysummer.musicplayer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "琴韵 · 古风音乐播放器",
      "width": 1100,
      "height": 720,
      "minWidth": 800,
      "minHeight": 560,
      "resizable": true,
      "fullscreen": false,
      "dragDropEnabled": true,
      "backgroundColor": "#0f0d0a",
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage", "deb", "rpm", "msi", "nsis"],
    "category": "Music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png",
             "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      }
    }
  }
}